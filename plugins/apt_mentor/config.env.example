# ==============================================================================
# ⚙️ CONFIGURACIÓN DE APT-MENTOR (Plantilla de ejemplo: config.env.example)
#
# Para personalizar en una máquina específica, copia este archivo a:
#   ~/.config/apt-mentor/config.env
#
# Si el archivo ~/.config/apt-mentor/config.env no existe, se aplican
# automáticamente los valores por defecto listados aquí.
# ==============================================================================

# Tiempo de espera (en segundos) en el menú de supd antes de continuar a la shell (0 = esperar indefinidamente)
APT_MENTOR_TIMEOUT=10

# Proveedor de IA activo:
#   - 'agy'     : Usa Antigravity CLI ('agy -p' para ficha y 'agy -i' para tutor interactivo).
#   - 'ollama'  : Usa modelos locales vía Ollama.
#   - 'generic' : Usa comandos personalizados definidos en las variables de abajo.
#   - 'offline' : Modo 100% nativo (apt-cache, man, whatis) sin conexión ni modelos de lenguaje.
APT_MENTOR_AI_PROVIDER="agy"

# Comandos para proveedor genérico (si se utiliza APT_MENTOR_AI_PROVIDER="generic"):
APT_MENTOR_GENERIC_PRINT_CMD="llm prompt"
APT_MENTOR_GENERIC_INTERACTIVE_CMD="ollama run llama3"

# Modelo específico para agy (opcional, deja vacío para heredar configuración global de agy):
APT_MENTOR_AGY_MODEL=""

# Estrategia pedagógica:
#   - 'foundations_first' : Prioriza cimientos del sistema (FHS, sudo, permisos, syscalls, WSL2) antes de paquetes.
#   - 'packages_first'    : Analiza directamente los paquetes pendientes de apt list --upgradable.
APT_MENTOR_STRATEGY="foundations_first"

# Nivel inicial del estudiante: 'basico' | 'intermedio' | 'avanzado'
APT_MENTOR_LEVEL="basico"

# Frecuencia de Checkpoint Evaluativo: cada cuántos conceptos acumulados sugerir reto práctico
APT_MENTOR_EVAL_CADENCE=5

# Habilitar telemetría volátil de hábitos en ~/.local/share/apt-mentor/usage_events.tsv: true | false
APT_MENTOR_TELEMETRY=true

# Rama y remoto por defecto para la sincronización manual ('supd sync'):
APT_MENTOR_GIT_REMOTE="origin"
APT_MENTOR_GIT_BRANCH="main"
